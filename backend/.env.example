# i-Save backend environment variables
# Copy this file to .env and fill in real values for staging.
# NEVER commit real secrets or database credentials to version control.

# Application
APP_ENV=development
APP_NAME=i-Save Backend
APP_DEBUG=true

# Database connection
# Local development: SQLite file database (no external database required).
DATABASE_URL=sqlite:///./data/i_save_dev.db

# Staging target: PostgreSQL. Uncomment and configure when a PostgreSQL
# instance is available. Do not commit real credentials.
# DATABASE_URL=postgresql+psycopg://isave_user:isave_pass@localhost:5432/isave

# Security (placeholders only — generate real random values for staging)
SECRET_KEY=replace-with-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Password setup invitations expire in 60 minutes (allowed range 5–1440).
PASSWORD_SETUP_EXPIRE_MINUTES=60
# Opt-in local capture only; production/staging sending is always disabled.
INVITATION_DELIVERY=disabled
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=isave-local@example.test
SMTP_TIMEOUT_SECONDS=5
PASSWORD_SETUP_FRONTEND_URL=http://localhost:3000

# CORS origins allowed to call the API (frontend dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Private registration evidence: no scanner bypass in development/production.
# Configure a private ClamAV daemon with current signatures before enabling uploads.
DOCUMENT_SCAN_HOST=
DOCUMENT_SCAN_PORT=3310
DOCUMENT_SCAN_TEST_ONLY=false
