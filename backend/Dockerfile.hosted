FROM python:3.12-slim
WORKDIR /app/backend
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN --mount=type=bind,source=app,target=/source,readonly python -c "import shutil; shutil.copytree('/source','app',ignore=shutil.ignore_patterns('*rehearsal*.py','__pycache__'))"
COPY alembic ./alembic
COPY alembic.ini ./
# Rehearsal modules never enter an exported image layer.
RUN useradd --system --uid 10001 isave
USER isave
CMD ["python", "-m", "app.hosted_server"]
