# i-Save Docker Compose environment variables
#
# Copy this file to `.env` and adjust as needed.
# NEVER commit real secrets or database credentials to version control.
# This file is intentionally safe to commit (placeholders only).

# PostgreSQL (local development only, bound to 127.0.0.1)
POSTGRES_USER=isave_user
POSTGRES_PASSWORD=isave_password_change_me
POSTGRES_DB=isave

# Backend
APP_ENV=development
APP_DEBUG=true
# DATABASE_URL is composed from POSTGRES_* above and points at the `db` service.
# Override this to target another database (e.g. a staging PostgreSQL instance).
# DATABASE_URL=postgresql+psycopg://isave_user:isave_password_change_me@db:5432/isave
SECRET_KEY=dev-secret-change-me-do-not-use-in-production
# Origins allowed to call the API from the browser (the frontend SSR app).
CORS_ORIGINS=http://localhost:3000
PASSWORD_SETUP_EXPIRE_MINUTES=60
# Used only with the explicit compose.mailpit.yaml local-development overlay.
# External SMTP and production/staging delivery are refused by the adapter.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=isave-local@example.test
SMTP_TIMEOUT_SECONDS=5
PASSWORD_SETUP_FRONTEND_URL=http://localhost:3000

# Frontend (Nitro) server
# Outside Docker, the same-origin authentication bridge defaults to the local API.
# Docker Compose sets this to http://backend:8000 inside the service network.
AUTH_API_ORIGIN=http://127.0.0.1:8000
HOST=0.0.0.0
PORT=3000
