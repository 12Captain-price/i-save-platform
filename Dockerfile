# Frontend image for i-Save.
#
# This is a TanStack Start / Nitro SSR application (NOT a plain Vite SPA).
# The production build is generated by Nitro and served with:
#   node .output/server/index.mjs
# (matches render.yaml: startCommand "node .output/server/index.mjs")
#
# Multi-stage build:
#   1. "build" stage installs dependencies and runs `npm run build` -> .output/
#   2. "run" stage copies only .output/ and serves it with Node.

# Stage 1: build
FROM node:24-alpine AS build
WORKDIR /app

# Install dependencies first (better layer caching). package-lock.json is the
# lockfile used by this project; npm ci installs devDependencies needed for build.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Copy application sources and build. .dockerignore keeps node_modules, .env,
# secrets, databases and previous build outputs out of the context.
COPY . .
# Nitro must use the node-server preset so `node .output/server/index.mjs`
# starts an HTTP server (the local default preset, cloudflare-module, only
# exports a fetch handler and exits under plain Node). Render uses its own
# render-com preset via render.yaml; Docker targets node-server.
ENV NITRO_PRESET=node-server
RUN npm run build

# Stage 2: run
FROM node:24-alpine AS run
WORKDIR /app

ENV HOST=0.0.0.0
ENV PORT=3000
ENV NODE_ENV=production

# Only the Nitro output is needed to run the server.
COPY --from=build /app/.output ./.output
COPY deploy/validate-frontend.mjs ./validate-frontend.mjs

EXPOSE 3000

# Non-root user for the runtime stage.
RUN adduser --system --disabled-password nitro && \
    chown -R nitro:root /app/.output
USER nitro

CMD ["node", "--import", "./validate-frontend.mjs", ".output/server/index.mjs"]
