map $uri $api_client {
  default "";
  /api/auth/logout "";
  ~^/api/ $binary_remote_addr;
}
limit_req_zone $api_client zone=clients:10m rate=180r/m;
server {
  listen 8080;
  server_name _;
  return 308 ${PUBLIC_ORIGIN}$request_uri;
}
server {
  listen 8443 ssl;
  server_name _;
  ssl_certificate /run/secrets/tls_certificate;
  ssl_certificate_key /run/secrets/tls_key;
  ssl_protocols TLSv1.2 TLSv1.3;
  client_max_body_size 9m;
  client_body_timeout 15s;
  keepalive_timeout 30s;
  limit_req_status 429;
  access_log off;
  error_log /dev/stderr crit;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  if ($http_host != "${PUBLIC_HOST}") { return 421; }
  location /api/v1/ { return 404; }
  location / {
    limit_req zone=clients burst=30 nodelay;
    proxy_pass http://frontend:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Isave-Gateway ${GATEWAY_TOKEN};
    proxy_set_header X-Isave-Client-IP $remote_addr;
    proxy_set_header X-Isave-Proto https;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Proto "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header Forwarded "";
    proxy_read_timeout 65s;
  }
}
